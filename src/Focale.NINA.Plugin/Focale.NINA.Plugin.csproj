<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net8.0-windows  — built against NINA 3.2 (the one we ship). NINA 3.3 runs on .NET 10,
                        which loads .NET 8 assemblies, so this single build serves 3.2 and 3.3.
      net10.0-windows — built against NINA 3.3, never shipped: it makes CI fail as soon as the
                        code uses an API NINA 3.3 changed or removed.
    -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>Focale.NINA.Plugin</RootNamespace>
    <AssemblyName>Focale.NINA.Plugin</AssemblyName>
    <!-- The plugin folder must carry its own runtime dependencies (SQLite), so copy them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Restore warnings about NINA's own dependency graph (.NET Framework-era packages, a
         nightly pointing at a missing alpha). None of it ships with the plugin. -->
    <NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>
  </PropertyGroup>

  <!--
    Host versions: what each NINA release itself depends on (NINA.Core's nuspec). The plugin is
    compiled against them and does NOT ship them (ExcludeAssets=runtime): NINA has them loaded
    already, and the plugin's [Export] attributes must be the very MEF types NINA looks for.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <NinaVersion>3.2.0.9001</NinaVersion>
    <MefVersion>8.0.0</MefVersion>
    <MvvmVersion>8.4.0</MvvmVersion>
    <NewtonsoftVersion>13.0.3</NewtonsoftVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <NinaVersion>3.3.0.1069-nightly</NinaVersion>
    <MefVersion>10.0.10</MefVersion>
    <MvvmVersion>8.4.2</MvvmVersion>
    <NewtonsoftVersion>13.0.4</NewtonsoftVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin"                       Version="$(NinaVersion)"      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.ComponentModel.Composition" Version="$(MefVersion)"       ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm"             Version="$(MvvmVersion)"      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json"                   Version="$(NewtonsoftVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin-only runtime dependencies. These DO ship inside the plugin folder. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
