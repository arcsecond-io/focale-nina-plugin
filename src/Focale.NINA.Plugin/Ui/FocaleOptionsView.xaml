<UserControl x:Class="Focale.NINA.Plugin.Ui.FocaleOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- Header: the Focale mark and what the plugin does, on Focale's navy -->
            <Border Background="{StaticResource FocaleNavyBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{StaticResource FocaleLogo}" Width="44" Height="44"
                           VerticalAlignment="Top" Margin="0,0,14,0" />
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <TextBlock Foreground="White" Opacity="0.6" HorizontalAlignment="Right" Text="{Binding VersionLabel, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Hyperlink Command="{Binding OpenFocaleCommand}" Foreground="{StaticResource FocaleLimeBrush}">focale.space</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="FOCALE" />
                        <TextBlock Foreground="{StaticResource FocaleLimeBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Your observing memory, in step with N.I.N.A." />
                        <TextBlock Foreground="White" Opacity="0.85" TextWrapping="Wrap" Margin="0,8,0,0">
                            <Run FontWeight="SemiBold" Text="NINA → Focale sync" />
                            <Run Text=" — every frame NINA saves, and the night's sessions and logs, fill your Focale memory as you capture (Observer plan and above)." />
                        </TextBlock>
                        <TextBlock Foreground="White" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run FontWeight="SemiBold" Text="Focale → NINA plans" />
                            <Run Text=" — tonight's targets and exposure plans from Focale, added to NINA's sequencer from the Focale Tonight panel (Imager plan and above)." />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Account -->
            <Border Style="{StaticResource FocaleSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FocaleSectionTitle}" Text="Focale account" />

                    <!-- Signed out: credentials -->
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}"
                                MaxWidth="360" HorizontalAlignment="Left">
                        <TextBlock Text="Email or username" />
                        <TextBox Text="{Binding UsernameEntry, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0" Text="Password" />
                        <PasswordBox x:Name="PasswordBoxControl" PasswordChanged="PasswordBoxControl_PasswordChanged" />
                        <Button Content="Sign in to Focale" Command="{Binding SignInCommand}" IsDefault="True"
                                HorizontalAlignment="Left" Padding="12,2" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource FocaleHint}" Text="No account yet? Create one on focale.space — it takes a minute." />
                    </StackPanel>

                    <!-- Signed in: identity, plan, sign-out -->
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock>
                            <Run Text="Signed in as " />
                            <Run FontWeight="Bold" Text="{Binding SignedInAs, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding PlanStatus}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Upgrade on focale.space" Command="{Binding OpenUpgradeCommand}" Margin="0,0,8,0" Padding="10,2"
                                    Visibility="{Binding CanUpgrade, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                            <Button Content="Check my plan again" Command="{Binding RefreshPlanCommand}" Margin="0,0,8,0" Padding="10,2" />
                            <Button Content="Sign out" Command="{Binding SignOutCommand}" Padding="10,2" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource NotificationWarningBrush}"
                               Text="{Binding AuthStatus}" />
                </StackPanel>
            </Border>

            <!-- Storage: chosen once; nothing is uploaded before -->
            <Border Style="{StaticResource FocaleSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FocaleSectionTitle}" Text="Where your frames go" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Focale always reads the header and measures the frame. Choose what happens to its pixels — nothing is uploaded until you do. This choice belongs to the active NINA profile." />
                    <RadioButton GroupName="FocaleStorageMode" IsChecked="{Binding IsIndexOnly, Mode=TwoWay}"
                                 Content="Index only — Focale reads each frame, then discards it. Nothing is kept but the metadata and measurements" />
                    <RadioButton GroupName="FocaleStorageMode" IsChecked="{Binding IsFocaleStorage, Mode=TwoWay}" Margin="0,4,0,0"
                                 Content="Focale storage — keep a copy in Focale (counts against your plan's storage)" />
                    <RadioButton GroupName="FocaleStorageMode" IsChecked="{Binding IsOwnStorage, Mode=TwoWay}" Margin="0,4,0,0"
                                 Content="My own storage — copy it to one of my storages (S3, SFTP, SMB, FTP, Dropbox), in a Focale folder keeping NINA's folders" />
                    <StackPanel Orientation="Horizontal" Margin="20,6,0,0"
                                Visibility="{Binding IsOwnStorage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <ComboBox MinWidth="260" ItemsSource="{Binding Storages}" SelectedItem="{Binding SelectedStorage, Mode=TwoWay}" />
                        <Button Content="Load my storages" Command="{Binding LoadStoragesCommand}" Margin="8,0,0,0" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" Text="{Binding StoragesStatus}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- NINA → Focale sync -->
            <Border Style="{StaticResource FocaleSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FocaleSectionTitle}" Text="NINA → Focale sync" />
                    <CheckBox IsChecked="{Binding EnableFitsUpload}"
                              Content="Send every FITS / XISF frame NINA saves" />
                    <CheckBox IsChecked="{Binding EnableNightEvents}" Margin="0,4,0,0"
                              Content="Send the night's log: sequence, autofocus, meridian flips, guiding RMS, dithers, park, safety" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Text="{Binding UploadStatus}" />
                        <Button Content="Resume" Command="{Binding ResumeUploadsCommand}" Margin="8,0,0,0" Padding="10,2"
                                Visibility="{Binding IsUploadPaused, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding PendingCount, StringFormat='Waiting: {0}'}" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding DeadCount, StringFormat='Refused: {0}'}" Margin="0,0,12,0"
                                   ToolTip="Frames Focale will never accept (removed or changed on disk, or rejected by the server). See NINA's log for why." />
                        <Button Content="Refresh" Command="{Binding RefreshQueueCommand}" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding LastQueueRefreshLabel}" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource FocaleSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FocaleSectionTitle}" Text="Privacy" />
                    <TextBlock TextWrapping="Wrap"
                        Text="• Only saved FITS / XISF files and, if enabled, the night's events (times, autofocus positions, guiding RMS…) are sent — no NINA profile, settings or log files. Nothing leaves your machine until you sign in and choose where frames go." />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                        Text="• Frames wait in the local queue while you are offline, signed out, or over a plan limit, and go up once that clears." />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                        Text="• Your password is never stored. The session token is kept encrypted for your Windows account (DPAPI) and can be revoked from Focale without signing you out elsewhere. HTTPS only, certificates always checked." />
                </StackPanel>
            </Border>

            <!-- Advanced: the API URL, for a self-hosted Focale only -->
            <Expander Header="Advanced" Margin="0,0,0,8">
                <StackPanel Margin="12,6,0,0" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Focale API URL" />
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource FocaleHint}"
                               Text="Leave it at https://api.focale.space unless you run your own Focale server. Sign out and in again after changing it." />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
