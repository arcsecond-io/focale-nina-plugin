<UserControl x:Class="Focale.NINA.Plugin.Ui.FocaleOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
        <StackPanel>

            <TextBlock FontWeight="Bold" FontSize="16" Margin="0,0,0,8" Text="Focale" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Bridges N.I.N.A. to Focale. Uploads every FITS or XISF frame NINA saves; Focale rebuilds your nights, targets and equipment from the file headers." />

            <!-- Server -->
            <GroupBox Header="Server" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="API URL" />
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="0,4,0,0" FontStyle="Italic" Foreground="Gray"
                               Text="Default: https://api.focale.space — same backend as api.arcsecond.io" />
                </StackPanel>
            </GroupBox>

            <!-- Sign-in -->
            <GroupBox Header="Sign in" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <!-- When NOT signed in: show credential entry -->
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                        <TextBlock Text="Username or email" />
                        <TextBox Text="{Binding UsernameEntry, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,4,0,0" Text="Password" />
                        <PasswordBox x:Name="PasswordBoxControl" PasswordChanged="PasswordBoxControl_PasswordChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Sign in" Command="{Binding SignInCommand}" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding AuthStatus}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic" Foreground="Gray"
                                   Text="The plugin authenticates with client_type=&quot;nina-plugin&quot;. Your refresh token is stored encrypted (Windows DPAPI, current-user scope); the access token lives in memory only and is refreshed automatically. Revoking the plugin from your account settings does not affect your web/desktop sessions." />
                    </StackPanel>

                    <!-- When signed in: show identity + sign-out -->
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock>
                            <Run Text="Signed in as " />
                            <Run FontWeight="Bold" Text="{Binding SignedInAs, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Sign out" Command="{Binding SignOutCommand}" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding AuthStatus}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Storage: chosen once, at sign-in; nothing is uploaded before -->
            <GroupBox Header="Where your frames go" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Focale always reads the header and measures the frame. Choose what happens to its pixels — nothing is uploaded until you do." />
                    <RadioButton GroupName="FocaleStorageMode" IsChecked="{Binding IsIndexOnly, Mode=TwoWay}"
                                 Content="Index only — keep the file on this computer; Focale keeps the metadata and measurements" />
                    <RadioButton GroupName="FocaleStorageMode" IsChecked="{Binding IsFocaleStorage, Mode=TwoWay}" Margin="0,4,0,0"
                                 Content="Focale storage — keep a copy in Focale (counts against your plan's storage)" />
                    <RadioButton GroupName="FocaleStorageMode" IsChecked="{Binding IsOwnStorage, Mode=TwoWay}" Margin="0,4,0,0"
                                 Content="My own storage — copy it to one of my storages (S3, SFTP, SMB, FTP, Dropbox), in a Focale folder keeping NINA's folders" />
                    <StackPanel Orientation="Horizontal" Margin="20,6,0,0"
                                Visibility="{Binding IsOwnStorage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <ComboBox MinWidth="260" ItemsSource="{Binding Storages}" SelectedItem="{Binding SelectedStorage, Mode=TwoWay}" />
                        <Button Content="Load my storages" Command="{Binding LoadStoragesCommand}" Margin="8,0,0,0" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" Text="{Binding StoragesStatus}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Features -->
            <GroupBox Header="Features" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox IsChecked="{Binding EnableFitsUpload}"
                              Content="Automatically upload every saved FITS / XISF frame" />
                    <CheckBox IsChecked="{Binding EnableNightEvents}" Margin="0,4,0,0"
                              Content="Send what happens during the night (sequence, autofocus, meridian flips, guiding RMS, dithers, park, safety) to the night's Logbook" />
                </StackPanel>
            </GroupBox>

            <!-- Queue -->
            <GroupBox Header="Upload queue" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding UploadStatus}" />
                        <Button Content="Resume uploads" Command="{Binding ResumeUploadsCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsUploadPaused, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh" Command="{Binding RefreshQueueCommand}" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding PendingCount, StringFormat='Pending: {0}'}" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding DeadCount, StringFormat='Dead: {0}'}" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding LastQueueRefreshLabel}" Foreground="Gray" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Privacy -->
            <GroupBox Header="Privacy">
                <StackPanel Margin="8">
                    <TextBlock TextWrapping="Wrap"
                        Text="• Refresh token stored encrypted (Windows DPAPI, current-user scope). Access token in memory only." />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                        Text="• HTTPS only; server certificate validated against the OS trust store. TLS verification is never disabled." />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                        Text="• Only saved FITS / XISF files and, if enabled, the night's events (times, autofocus positions, guiding RMS…) are sent — no NINA profile, settings or log files. Nothing leaves your machine until you sign in and choose where frames go." />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                        Text="• Frames wait in the local queue while you are offline, signed out, or over a plan limit, and go up once that clears." />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
