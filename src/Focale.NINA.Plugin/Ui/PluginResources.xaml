<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
                    xmlns:wpf="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
                    xmlns:ui="clr-namespace:Focale.NINA.Plugin.Ui"
                    xmlns:plugin="clr-namespace:Focale.NINA.Plugin"
                    xmlns:push="clr-namespace:Focale.NINA.Plugin.Push"
                    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
                    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer">

    <!-- Focale's brand colours (focale-front icon-focale.svg): navy ground, lime rays, yellow star. -->
    <Color x:Key="FocaleNavyColor">#011040</Color>
    <Color x:Key="FocaleLimeColor">#AAFF00</Color>
    <Color x:Key="FocaleYellowColor">#FFE800</Color>
    <SolidColorBrush x:Key="FocaleNavyBrush"   Color="{StaticResource FocaleNavyColor}" />
    <SolidColorBrush x:Key="FocaleLimeBrush"   Color="{StaticResource FocaleLimeColor}" />
    <SolidColorBrush x:Key="FocaleYellowBrush" Color="{StaticResource FocaleYellowColor}" />

    <!-- The Focale mark (focale-home icon-logo-xs.svg), 24×24. -->
    <DrawingImage x:Key="FocaleLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource FocaleNavyBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M11,2 L13,2 L12,9.5 Z M11,22 L13,22 L12,14.5 Z M2,11 L2,13 L9.5,12 Z M22,11 L22,13 L14.5,12 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource FocaleLimeColor}" Opacity="0.6" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M7,5.5 C7.8,10 7.8,14 7,18.5 M7,5.5 C10.5,6.5 14,6.5 17,5.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource FocaleYellowBrush}"
                                 Geometry="M12.5,9.5 L13.3,11.7 L15.5,12.5 L13.3,13.3 L12.5,15.5 L11.7,13.3 L9.5,12.5 L11.7,11.7 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- A small heading for each section of the settings page. -->
    <Style x:Key="FocaleSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A section of the settings page: a thin lime rule on the left, like Focale's cards. -->
    <Style x:Key="FocaleSection" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource FocaleLimeBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="12,6,8,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="FocaleHint" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Visibility converters used by FocaleOptionsView for the sign-in / sign-out swap. -->
    <wpf:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

    <!--
        PluginOptionsDataTemplateSelector resolves the options page by looking up
        Application.Current.Resources["<PluginName>_Options"] (see
        NINA/ViewModel/Plugins/PluginOptionsDataTemplateSelector.cs:31).
        The plugin's Name comes from [AssemblyTitle("Focale")], so the key is "Focale_Options".
    -->
    <DataTemplate x:Key="Focale_Options" DataType="{x:Type plugin:FocalePlugin}">
        <ui:FocaleOptionsView DataContext="{Binding OptionsViewModel}" />
    </DataTemplate>

    <!--
        A dock panel's view is looked up as "<full type name of its view model>_Dockable"
        (NINA plugin template, docs/ui-and-settings.md).
    -->
    <DataTemplate x:Key="Focale.NINA.Plugin.Ui.FocaleTonightDockable_Dockable">
        <ui:FocaleTonightView />
    </DataTemplate>

    <!--
        The Advanced Sequencer's Focale steps ("Focale: mark active" / "Focale: mark done"). Their icon is
        looked up by the [ExportMetadata("Icon")] key; their views by DataType, and in the mini sequencer
        as "<full type name>_Mini" (NINA plugin template).
    -->
    <GeometryGroup x:Key="Focale_MarkSVG" FillRule="Nonzero">
        <PathGeometry Figures="M11,2 L13,2 L12,9.5 Z M11,22 L13,22 L12,14.5 Z M2,11 L2,13 L9.5,12 Z M22,11 L22,13 L14.5,12 Z" />
        <PathGeometry Figures="M6.1,5.5 C6.9,10 6.9,14 6.1,18.5 L7.9,18.5 C8.7,14 8.7,10 7.9,5.5 Z" />
        <PathGeometry Figures="M6.6,4.7 C10.4,5.8 14,5.8 17,4.7 L17,6.5 C14,7.5 10.4,7.5 6.6,6.5 Z" />
        <PathGeometry Figures="M12.5,9.5 L13.3,11.7 L15.5,12.5 L13.3,13.3 L12.5,15.5 L11.7,13.3 L9.5,12.5 L11.7,11.7 Z" />
    </GeometryGroup>

    <DataTemplate x:Key="FocalePlanStatusContent">
        <TextBlock VerticalAlignment="Center" Text="{Binding Explanation}" TextWrapping="Wrap" Opacity="0.8" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type push:MarkPlanEntryActive}">
        <nina:SequenceBlockView DataContext="{Binding}">
            <nina:SequenceBlockView.SequenceItemContent>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FocalePlanStatusContent}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type push:MarkPlanEntryDone}">
        <nina:SequenceBlockView DataContext="{Binding}">
            <nina:SequenceBlockView.SequenceItemContent>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FocalePlanStatusContent}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
    <DataTemplate x:Key="Focale.NINA.Plugin.Push.MarkPlanEntryActive_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>
    <DataTemplate x:Key="Focale.NINA.Plugin.Push.MarkPlanEntryDone_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

</ResourceDictionary>
