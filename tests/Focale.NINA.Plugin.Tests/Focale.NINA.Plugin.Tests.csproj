<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same two targets as the plugin: the shipped NINA 3.2 build, and the NINA 3.3 check build.
         -windows because the SUT uses DPAPI (Windows-only) and WPF types. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <NinaVersion>3.2.0.9001</NinaVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <NinaVersion>3.3.0.1069-nightly</NinaVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unlike the plugin, tests run outside NINA, so they need NINA's assemblies at runtime. -->
    <PackageReference Include="NINA.Plugin"             Version="$(NinaVersion)" />
    <PackageReference Include="NUnit"                   Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter"       Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"  Version="17.11.1" />
    <PackageReference Include="FluentAssertions"        Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Focale.NINA.Plugin\Focale.NINA.Plugin.csproj" />
  </ItemGroup>
</Project>
